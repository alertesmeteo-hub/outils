# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Météo Outils"
# Page ou URL du service d'attestation / relevé météo (CTA)
NEXT_PUBLIC_WEATHER_REPORT_URL=/attestation-meteo/
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.fr

# --- Base de données (optionnelle : sans elle, les outils fonctionnent, l'admin est désactivé) ---
DATABASE_URL=postgresql://meteo:meteo@localhost:5432/meteo

# --- Administration (/admin) : laisser vide pour DÉSACTIVER l'admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-long-random-password

# --- Intégration iframe : origines autorisées (séparées par des espaces), défaut = toutes ---
EMBED_ALLOWED_ORIGINS=

# --- Fournisseur météo (futur, côté serveur uniquement, jamais NEXT_PUBLIC_) ---
WEATHER_PROVIDER=none
WEATHER_API_KEY=

# --- Classements des stations (/classements) : observations Météo-France, côté serveur ---
# Clé du portail https://portail-api.meteofrance.fr (souscrire aux API « Observations » et « Paquet Observations »)
METEOFRANCE_API_KEY=
# Seulement si vous avez une clé distincte par API (sinon laisser vide) :
METEOFRANCE_PAQUET_API_KEY=
METEOFRANCE_OBS_API_KEY=
# Rafraîchissement (minutes) et pause entre requêtes (ms, respect du quota)
OBS_REFRESH_MINUTES=30
METEOFRANCE_PAUSE_MS=1300
# Dossier du cache disque (historique 96 h pour les cumuls 48 h / 72 h)
OBS_CACHE_DIR=
# Flux JSON facultatif de stations amateurs : { "stations": [...], "obs": { "<id>": [...] } }
AMATEUR_OBS_URL=
# Stations amateurs StatIC (Infoclimat Open Data) : jeton personnel et identifiants séparés par des virgules
INFOCLIMAT_TOKEN=
INFOCLIMAT_STATIONS=
# Normales 1991-2020 et records : dépôt climato (vide = désactivé)
CLIMATO_DATA_URL=https://raw.githubusercontent.com/alertesmeteo-hub/climato/data
# Fichier des records manuels, prioritaire (défaut data/records.json, modèle : data/records.example.json)
RECORDS_FILE=
# Lien de chaque station dans les classements ({id} = identifiant Météo-France à 8 chiffres)
STATION_URL_TEMPLATE=https://alertes-meteo.com/climatologie/climato_meteo/?station={id}
# Rafales SYNOP (fichier annuel ~25 Mo, toutes les 3 h) : SYNOP_DISABLED=1 pour couper
SYNOP_DISABLED=
# Paquet 6 minutes v2 (rafales raf10 et T° du moment, 1 requête / 6 min) : OBS_6MIN=0 pour couper
OBS_6MIN=
