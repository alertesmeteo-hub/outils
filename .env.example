# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Météo Outils"
# Page ou URL du service d'attestation / relevé météo (CTA)
NEXT_PUBLIC_WEATHER_REPORT_URL=/attestation-meteo/
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.fr

# --- Base de données (optionnelle : sans elle, les outils fonctionnent, l'admin est désactivé) ---
DATABASE_URL=postgresql://meteo:meteo@localhost:5432/meteo

# --- Administration (/admin) : laisser vide pour DÉSACTIVER l'admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-long-random-password

# --- Intégration iframe : origines autorisées (séparées par des espaces), défaut = toutes ---
EMBED_ALLOWED_ORIGINS=

# --- Fournisseur météo (futur, côté serveur uniquement, jamais NEXT_PUBLIC_) ---
WEATHER_PROVIDER=none
WEATHER_API_KEY=
